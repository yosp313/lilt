{
  "name": "lilt",
  "productName": "Lilt",
  "version": "1.0.0",
  "private": true,
  "description": "A bot-free meeting notepad: dual-stream capture, live transcript, notes you keep.",
  "keywords": [
    "meetings",
    "notes",
    "transcription",
    "electron"
  ],
  "license": "MIT",
  "author": {
    "name": "Youssef Ayman",
    "email": "youssef.ayman@tagaddod.com"
  },
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "electron-forge release",
    "lint": "oxlint && oxfmt --check src index.html",
    "lint:fix": "oxlint --fix && oxfmt --write src index.html",
    "typecheck": "tsc --noEmit",
    "build:whisper": "node scripts/build-whisper.mjs",
    "test": "node --test src/shared/*.test.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "electron": "45.0.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "idb": "^8.0.4"
  }
}
